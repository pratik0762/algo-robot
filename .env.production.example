# =====================================================================
# Algo Robot - Production Environment Secrets Template
# =====================================================================

# Server Settings
NODE_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend Security
JWT_SECRET_KEY=generate_a_random_32_byte_secret_hex_here_for_production
CORS_ORIGINS=https://algo-robot.local,http://localhost:3000,http://127.0.0.1:3000

# Zerodha Kite Connect
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_CLIENT_ID=your_client_id

# Angel One SmartAPI
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=your_mpin
ANGEL_TOTP_SECRET=your_base32_totp_secret

# Dhan HQ
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# Upstox API v2
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_ACCESS_TOKEN=your_upstox_oauth_token

# Real-Time Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_signals_channel
WEBHOOK_URL=https://your-domain.com/webhook/signals
WEBHOOK_AUTH_HEADER=Bearer your_secure_webhook_secret
