[Unit]
Description=Algo Robot Trading Platform (Next.js Frontend)
After=network.target algo-robot-backend.service
Wants=algo-robot-backend.service

[Service]
Type=simple
User=nextjs
Group=nodejs
WorkingDirectory=/opt/algo-robot/frontend
Environment="PATH=/usr/local/bin:/usr/bin"
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=0.0.0.0"

ExecStart=/usr/bin/npm run start -- -H 0.0.0.0

Restart=always
RestartSec=5s
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=algo-robot-frontend

[Install]
WantedBy=multi-user.target
