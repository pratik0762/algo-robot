# ==============================================================================
# ALGO ROBOT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with authorized credentials.
# RULE: NEVER COMMIT REAL CREDENTIALS, TOKENS, OR MASTER KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="ALGO ROBOT Trading Platform"
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. SECURITY, JWT & AES-256-GCM ENCRYPTION
# ------------------------------------------------------------------------------
# Master secret key for JWT session signing (min 32 characters)
SECRET_KEY=change-this-to-a-very-secure-random-32-byte-secret-in-production

# 32-byte hex-encoded key for AES-256-GCM symmetric encryption of broker secrets
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Outbound Webhook Security (SSRF Protection)
ALLOW_PRIVATE_IPS_IN_WEBHOOKS=false

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL / TIMESCALEDB / SQLITE)
# ------------------------------------------------------------------------------
# Async database URL (for FastAPI async session)
DATABASE_URL=sqlite+aiosqlite:///./algo_robot.db
# PostgreSQL / TimescaleDB example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/algo_robot

# Synchronous database URL (for migrations & sync utilities)
SYNC_DATABASE_URL=sqlite:///./algo_robot.db
# PostgreSQL example:
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algo_robot

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED CACHE & PUB/SUB (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ------------------------------------------------------------------------------
# 5. MARKET DATA & BROKER APIS
# ------------------------------------------------------------------------------
# Strict real-data enforcement mode: "REAL_ONLY" disables all mock/random ticks
DATA_SOURCE_MODE=REAL_ONLY

# Zerodha Kite Connect & Ticker
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Angel One SmartAPI & SmartStream
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_KEY=

# Upstox API V2
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/broker/upstox/callback

# Dhan HQ API
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Finvasia Shoonya API
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_FACTOR2=
SHOONYA_VC=
SHOONYA_API_KEY=

# Paytm Money Open API
PAYTM_MONEY_API_KEY=
PAYTM_MONEY_API_SECRET=
PAYTM_MONEY_REQUEST_TOKEN=
PAYTM_MONEY_ACCESS_TOKEN=
PAYTM_MONEY_PUBLIC_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 6. NOTIFICATION & ALERT CHANNELS
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
